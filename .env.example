APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
# Use "database" in production: compute is ephemeral, so file-based sessions
# are wiped on every deploy and are not shared between instances.
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Customer uploads disk. Set to "s3" in production (ephemeral compute) with an
# S3-compatible bucket (Laravel Cloud bucket / Cloudflare R2). Falls back to
# the AWS_* values above when the PRIVATE_DISK_* overrides are unset.
PRIVATE_DISK_DRIVER=local
PRIVATE_DISK_KEY=
PRIVATE_DISK_SECRET=
PRIVATE_DISK_REGION=
PRIVATE_DISK_BUCKET=
PRIVATE_DISK_ENDPOINT=

# Signup/login reCAPTCHA. Keys are domain-scoped, so enable this only after
# registering the live domain in the Google reCAPTCHA admin console.
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Error monitoring — reporting is disabled when the DSN is empty.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Nightly DB backups land on this filesystem disk ("private" in production).
# Enable mail notifications only after production SMTP credentials are set.
BACKUP_DISK=local
BACKUP_NOTIFICATIONS_ENABLED=false
BACKUP_NOTIFICATION_EMAIL=admin@rapidrebuilt.com

# AI document extraction (Prism). The provider API key itself is read by
# config/prism.php from that provider's own env var, so switching
# EXTRACTION_PROVIDER also means setting the matching key below.
EXTRACTION_PROVIDER=anthropic
EXTRACTION_MODEL=claude-sonnet-4-5
EXTRACTION_MAX_TOKENS=2048
EXTRACTION_TIMEOUT=60
# ANTHROPIC_API_KEY=

# DMV forms are filled with pdftk, an external binary. Normally nothing needs
# setting: the app uses vendor-bin/pdftk if scripts/install-pdftk.sh has run
# (this is how production gets one), and otherwise falls back to pdftk on the
# PATH. Set this only to force a specific binary.
# PDFTK_BINARY=/usr/local/bin/pdftk

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
